# Copy to `.env` in this directory (deploy/docker/.env) before `docker compose up`.
# docker-compose.yml requires this — the container binds 0.0.0.0, so the
# server refuses to start without an API key.
#
# Generate a key with:  jarvis auth generate-key
# Then clients must send:  Authorization: Bearer <key>
OPENJARVIS_API_KEY=

# --- Media (sound effects and video). Placeholders only; real values go in the host's environment settings, never in git. ---
# Off unless MEDIA_ENABLED is on AND DAILY_MEDIA_SPEND_CAP_USD is above 0 (see SECURITY-CHANGES.md).
# Sound effects and video have NO provider yet: leave these empty until one is approved.
MEDIA_SFX_PROVIDER=
MEDIA_VIDEO_PROVIDER=
# Hard limits (the server refuses requests above them):
MEDIA_SFX_MAX_SECONDS=10
VIDEO_MAX_SECONDS=5
VIDEO_MAX_HEIGHT=720
